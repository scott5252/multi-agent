nant:admin","skill-registry:install","skill-registry:bind","skill-registry:audit","skill-execution:read","agent-tests:manage","agent-tests:run","agent-tests:read","agent-tests:gate","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve","usage:read","usage:export","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit","telegram-config:read","telegram-config:write","telegram-config:tokens","telegram-config:diagnostics"]},"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"Acme Tenant User","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve"]},"tenant-reviewer-acme":{"catalog_key":"tenant-reviewer-acme","display_name":"Acme Reviewer","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","agent-tests:read"]},"operations-auditor":{"catalog_key":"operations-auditor","display_name":"Operations Auditor","tenant_id":null,"org_id":"org-platform","role_codes":[],"permission_codes":["operations:read","operations:logs","operations:export"]}}

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform
DATABASE_ECHO=false

# Optional separate LangGraph checkpointer database URL. Leave blank locally to
# use DATABASE_URL. If set, use the checkpointer/client URL shape expected by
# the runtime, for example postgresql://postgres:postgres@127.0.0.1:5432/name.
RUNTIME_CHECKPOINTER_DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Fill this value locally before using live OpenAI-backed reviewer execution.
# This file is ignored by git through the .env* rule.
OPENAI_API_KEY=

# The static provider is intentional for this tutorial file: the app loads
# .env through Settings, and provider records still store only safe references.
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"example/api-key":"dev-secret","local/openai-placeholder":"${OPENAI_API_KEY}","local/local-openai-compatible-placeholder":"dev-local-model-placeholder","local/telegram-provider-token":"dev-telegram-placeholder","local/channel-callback":"dev-callback-placeholder","local/tool-credential-placeholder":"dev-tool-credential-placeholder","local/artifact-placeholder":"dev-artifact-placeholder"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

# ---------------------------------------------------------------------------
# Artifact storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/artifacts
S3_BUCKET=multi-agent-platform
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
TRACING_ENABLED=false

# ---------------------------------------------------------------------------
# Workers and runtime retention
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Reliability and scale controls
# ---------------------------------------------------------------------------
RELIABILITY_MAX_SUBMITTED_WORK=1000
RELIABILITY_MAX_ACTIVE_WORK=250
RELIABILITY_RETRY_BUDGET_PER_WINDOW=500
RELIABILITY_MAX_RETRY_ATTEMPTS=3
RELIABILITY_LEASE_EXPIRY_SECONDS=120
RELIABILITY_LEASE_RENEWAL_SECONDS=30
RELIABILITY_BREAKER_FAILURE_THRESHOLD=5
RELIABILITY_BREAKER_COOLDOWN_SECONDS=60
RELIABILITY_ARTIFACT_TENANT_CONCURRENCY=10
RELIABILITY_ARTIFACT_GLOBAL_CONCURRENCY=100
RELIABILITY_DB_POOL_WAIT_P95_MS_THRESHOLD=250
RELIABILITY_ADMIN_CONNECTION_RESERVE_FRACTION=0.2

# ---------------------------------------------------------------------------
# Model provider gateway
# ---------------------------------------------------------------------------
# OpenAI provider connections must reference local/openai-placeholder.
# Local OpenAI-compatible connections may omit credentials only when their base
# URL matches the allowlist below.
MODEL_PROVIDER_LOCAL_ALLOWED_SCHEMES=["http","https"]
MODEL_PROVIDER_LOCAL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
MODEL_PROVIDER_LOCAL_ALLOWED_PORTS=[8000,8080,11434]
MODEL_PROVIDER_LOCAL_ALLOWED_CIDRS=["127.0.0.0/8"]
MODEL_PROVIDER_PROBE_TIMEOUT_SECONDS=60.0
MODEL_PROVIDER_GATEWAY_MIN_TIMEOUT_SECONDS=0.1
MODEL_PROVIDER_GATEWAY_MAX_TIMEOUT_SECONDS=300.0

# ---------------------------------------------------------------------------
# Telegram and interaction channels
# ---------------------------------------------------------------------------
# Local webhook secret is intentionally plain for deterministic webhook tests.
# Production must use secret references for provider tokens and callback signing.
TELEGRAM_WEBHOOK_SECRET=local-dev-secret
TELEGRAM_PROVIDER_TOKEN_REF=static:local/telegram-provider-token
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_CALLBACK_SIGNING_SECRET_REF=static:local/channel-callback
CHANNEL_ARTIFACT_URL_TTL_SECONDS=900
CHANNEL_ARTIFACT_URL_MAX_TTL_SECONDS=3600
CHANNEL_SSE_HEARTBEAT_SECONDS=15
CHANNEL_RATE_LIMIT_PER_MINUTE=120
