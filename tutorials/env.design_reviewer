# Local Design Reviewer Council environment with OpenAI model-provider support.
#
# Usage:
#   1. cp .env.design_reviewer .env
#   2. Fill OPENAI_API_KEY with a real OpenAI API key.
#   3. docker compose up -d postgres
#   4. uv run alembic upgrade head
#   5. uv run uvicorn multi_agent_platform.api.main:app --reload
#   6. uv run python -m multi_agent_platform.workers.main
#
# In Governance, create or inspect an OpenAI provider connection that stores
# credential reference local/openai-placeholder. Do not paste the raw key into
# provider connection fields.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00

# ---------------------------------------------------------------------------
# Authentication and local QA principals
# ---------------------------------------------------------------------------
AUTH_MODE=local_principal

# Auth0 values are not used while AUTH_MODE=local_principal, but keeping safe
# examples here makes it clear what must be changed for Auth0 testing.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=multi-agent-platform
AUTH0_ALGORITHMS=["RS256"]
AUTH0_REQUIRED_ORG_CLAIM=true
AUTH0_JWKS_PATH=/.well-known/jwks.json

LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
