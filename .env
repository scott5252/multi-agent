# QA009 self-contained local environment.
# Copy this file to repo-root .env before running the QA009 checklist.

# Application
APP_ENV=test
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00

# Authentication
AUTH_MODE=local_principal
AUTH0_DOMAIN=qa009.local.auth0.example
AUTH0_ISSUER=https://qa009.local.auth0.example/
AUTH0_AUDIENCE=multi-agent-platform-qa009
AUTH0_ALGORITHMS=["RS256"]
AUTH0_REQUIRED_ORG_CLAIM=true
AUTH0_JWKS_PATH=/.well-known/jwks.json
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","tenant_id":null,"org_id":"org-platform","role_codes":["platform_admin","admin"],"permission_codes":["tenant:read","tenant:admin","reliability:read","reliability:write"]},"tenant-operator-acme":{"catalog_key":"tenant-operator-acme","display_name":"Acme Tenant Operator","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","operator"],"permission_codes":["tenant:read","reliability:read","reliability:write"]},"auditor-acme":{"catalog_key":"auditor-acme","display_name":"Acme Reliability Auditor","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","auditor"],"permission_codes":["tenant:read","reliability:read"]},"tenant-operator-globex":{"catalog_key":"tenant-operator-globex","display_name":"Globex Tenant Operator","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","operator"],"permission_codes":["tenant:read","reliability:read","reliability:write"]}}

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa009
DATABASE_ECHO=false
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa009
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=90

# Secrets
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa009/model-provider-placeholder":"qa009-model-provider-placeholder","qa009/tool-credential-placeholder":"qa009-tool-credential-placeholder","qa009/notification-placeholder":"qa009-notification-placeholder","qa009/object-storage-placeholder":"qa009-object-storage-placeholder"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

# Storage
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa009-artifacts
S3_BUCKET=multi-agent-platform-qa009
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=false

# Workers
WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120

# Reliability defaults used by QA009 policy/state-machine checks.
RELIABILITY_MAX_SUBMITTED_WORK=1000
RELIABILITY_MAX_ACTIVE_WORK=250
RELIABILITY_RETRY_BUDGET_PER_WINDOW=500
RELIABILITY_MAX_RETRY_ATTEMPTS=3
RELIABILITY_LEASE_EXPIRY_SECONDS=120
RELIABILITY_LEASE_RENEWAL_SECONDS=30
RELIABILITY_BREAKER_FAILURE_THRESHOLD=5
RELIABILITY_BREAKER_COOLDOWN_SECONDS=60
RELIABILITY_ARTIFACT_TENANT_CONCURRENCY=10
RELIABILITY_ARTIFACT_GLOBAL_CONCURRENCY=100
RELIABILITY_DB_POOL_WAIT_P95_MS_THRESHOLD=250
RELIABILITY_ADMIN_CONNECTION_RESERVE_FRACTION=0.2

# User interaction channels remain configured because runtime/channel settings
# are part of the shared application Settings surface.
TELEGRAM_WEBHOOK_SECRET=local-dev-secret
TELEGRAM_PROVIDER_TOKEN_REF=qa009/notification-placeholder
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_CALLBACK_SIGNING_SECRET_REF=qa009/tool-credential-placeholder
CHANNEL_ARTIFACT_URL_TTL_SECONDS=900
CHANNEL_ARTIFACT_URL_MAX_TTL_SECONDS=3600
CHANNEL_SSE_HEARTBEAT_SECONDS=15
CHANNEL_RATE_LIMIT_PER_MINUTE=120
