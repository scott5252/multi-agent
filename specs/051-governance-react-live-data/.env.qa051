APP_ENV=test
APP_NAME=multi-agent-platform-qa051
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
ENABLE_METRICS=true
ENABLE_TRACING=false
TRACE_SAMPLE_RATE=0.0
AUTH_MODE=local_principal
AUTH0_DOMAIN=qa051.invalid
AUTH0_AUDIENCE=multi-agent-platform-qa051
AUTH0_ISSUER=https://qa051.invalid/
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","role_codes":["platform_admin"],"permission_codes":["tenant:read","tenant:admin","operations:read","run-inspection:read","admin:model-providers:write","skill-registry:publish","skill-execution:read"],"org_id":"platform"},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Acme Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","channel:runs:read","channel:runs:create","skill-registry:install","skill-registry:bind"]},"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"Acme Tenant User","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","channel:runs:read"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]}}
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa051
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa051
ALEMBIC_CONFIG=alembic.ini
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa051/governance-placeholder":"redacted-governance-value-qa051","qa051/provider-placeholder":"redacted-provider-value-qa051"}
PROVIDER_SECRET_REFERENCE_PREFIX=qa051/
ALLOW_LIVE_PROVIDER_PROBES=false
ALLOW_LIVE_TELEGRAM=false
ALLOW_EXTERNAL_CONNECTORS=false
MODEL_GATEWAY_ENABLE_DIRECT_CALL_GUARDRAIL=true
MODEL_PROVIDER_LOCAL_NO_AUTH_ALLOWLIST=127.0.0.1,localhost
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa051-artifacts
EXPORT_STORAGE_PREFIX=qa051/exports
QA_EVIDENCE_ROOT=.data/qa051-artifacts/evidence
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=30
ENABLE_RUNTIME_WORKER=true
CHANNEL_DELIVERY_MODE=mock
TELEGRAM_BOT_API_MODE=mock
SKILL_EXECUTION_CONNECTOR_MODE=mock
SSE_HEARTBEAT_SECONDS=10
RATE_LIMIT_ENABLED=false
ADMIN_REACT_DEV_MODE=false
ADMIN_REACT_MANIFEST_REQUIRED=true
ADMIN_REACT_ASSET_ROOT=src/multi_agent_platform/web_admin/static/react
QA_SPEC_ID=qa051
QA_SPEC_TITLE=Governance React Live Data
QA_PRIMARY_ROUTE=/admin/app/governance
QA_GOVERNANCE_BOOTSTRAP_ROUTE=/admin/app/governance/bootstrap.json
QA_GOVERNANCE_PROMPTS_ROUTE=/admin/app/governance/prompts.json
QA_GOVERNANCE_PROVIDERS_ROUTE=/admin/app/governance/providers.json
QA_GOVERNANCE_HISTORY_ROUTE=/admin/app/governance/history.json
QA_PLAYWRIGHT_OUTPUT=output/playwright/qa051_ui
