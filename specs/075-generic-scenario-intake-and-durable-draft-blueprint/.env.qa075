# QA075 local QA environment for Generic Scenario Intake And Durable Draft Blueprint
APP_ENV=local
APP_NAME=multi-agent-platform
API_HOST=127.0.0.1
API_PORT=8000
AUTH_MODE=local_principal
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","tenant_id":null,"org_id":"org-platform","role_codes":["platform_admin"],"permission_codes":["platform:admin","tenant:read","tenant:admin","admin:role-grants:write","admin:support-overrides:write","admin:support-overrides:approve","skill-registry:publish","skill-registry:quarantine","skill-registry:audit","skill-execution:read","agent-tests:manage","agent-tests:run","agent-tests:read","agent-tests:gate","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve","usage:read","usage:export","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit","telegram-config:read","telegram-config:write","telegram-config:tokens","telegram-config:diagnostics","operations:read","operations:logs","operations:export"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Acme Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","skill-registry:install","skill-registry:bind","skill-registry:audit","skill-execution:read","agent-tests:manage","agent-tests:run","agent-tests:read","agent-tests:gate","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve","usage:read","usage:export","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit","telegram-config:read","telegram-config:write","telegram-config:tokens","telegram-config:diagnostics"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","skill-registry:install","skill-registry:bind","skill-registry:audit","skill-execution:read","agent-tests:manage","agent-tests:run","agent-tests:read","agent-tests:gate","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve","usage:read","usage:export","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit","telegram-config:read","telegram-config:write","telegram-config:tokens","telegram-config:diagnostics"]},"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"Acme Tenant User","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve"]},"tenant-reviewer-acme":{"catalog_key":"tenant-reviewer-acme","display_name":"Acme Reviewer","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","agent-tests:read"]},"operations-auditor":{"catalog_key":"operations-auditor","display_name":"Operations Auditor","tenant_id":null,"org_id":"org-platform","role_codes":[],"permission_codes":["operations:read","operations:logs","operations:export"]}}
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa075
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa075
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa075/local-model-key":"fake-local-key","qa075/telegram-token":"fake-local-token","qa075/provider-key":"fake-provider-key"}
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa075-artifacts
MODEL_PROVIDER_DEFAULT=mock_model
MODEL_GATEWAY_ENABLE_LIVE_CALLS=false
TELEGRAM_DELIVERY_MODE=mock
OUTBOUND_NETWORK_MODE=disabled
WORKFLOW_VALIDATION_MODE=deterministic
TEST_BENCH_EXECUTION_MODE=deterministic
LOG_LEVEL=INFO
REDACTION_MODE=strict
AUDIT_CAPTURE_ENABLED=true
ENABLE_REACT_ADMIN=true
VITE_ADMIN_BASE=/admin/app
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8000
PLAYWRIGHT_OUTPUT_DIR=output/playwright/qa075_ui
QA_ARTIFACT_ROOT=.data/qa075-artifacts
QA_SCREENSHOT_ROOT=.data/qa075-artifacts/screenshots
QA_LOG_ROOT=.data/qa075-artifacts/logs
QA_DATABASE_NAME=multi_agent_platform_qa075
QA_SECRET_NAMESPACE=qa075/
QA_TENANT_ACME=11111111-1111-1111-1111-111111111111
QA_TENANT_GLOBEX=22222222-2222-2222-2222-222222222222
QA_LOCAL_PRINCIPAL=tenant-admin-acme
QA_SECONDARY_PRINCIPAL=tenant-admin-globex
QA_PLATFORM_PRINCIPAL=platform-admin
QA_ENABLE_EXTERNAL_CALLS=false
QA_ENABLE_REAL_CREDENTIALS=false
QA_ALLOW_RAW_TRANSCRIPTS=false
QA_ALLOW_RAW_PROMPTS=false
QA_REQUIRE_VISIBLE_UI_NAVIGATION=true
QA_VIEWPORT_WIDTH=1280
QA_VIEWPORT_HEIGHT=800
