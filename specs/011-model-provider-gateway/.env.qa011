# QA011 self-contained local environment.
# Copy this file to repo-root .env before running the QA011 checklist.

APP_ENV=test
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00

AUTH_MODE=local_principal
AUTH0_DOMAIN=qa011.local.auth0.example
AUTH0_ISSUER=https://qa011.local.auth0.example/
AUTH0_AUDIENCE=multi-agent-platform-qa011
AUTH0_ALGORITHMS=["RS256"]
AUTH0_REQUIRED_ORG_CLAIM=true
AUTH0_JWKS_PATH=/.well-known/jwks.json
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"QA011 Platform Admin","tenant_id":null,"org_id":"org-platform","role_codes":["platform_admin"],"permission_codes":["admin:role-grants:write","admin:support-overrides:write","admin:support-overrides:approve","tenant:read","tenant:admin"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Acme Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]},"operator-acme":{"catalog_key":"operator-acme","display_name":"Acme Operator","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read"]}}

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa011
DATABASE_ECHO=false
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa011
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=90

SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa011/openai-placeholder":"qa011-openai-placeholder","qa011/local-placeholder":"qa011-local-placeholder","qa011/channel-placeholder":"qa011-channel-placeholder"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa011-artifacts
S3_BUCKET=multi-agent-platform-qa011
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

MODEL_PROVIDER_LOCAL_ALLOWED_SCHEMES=["http","https"]
MODEL_PROVIDER_LOCAL_ALLOWED_HOSTS=["127.0.0.1","localhost"]
MODEL_PROVIDER_LOCAL_ALLOWED_PORTS=[8000,8080,11434]
MODEL_PROVIDER_LOCAL_ALLOWED_CIDRS=["127.0.0.0/8"]
MODEL_PROVIDER_PROBE_TIMEOUT_SECONDS=30
MODEL_PROVIDER_GATEWAY_MIN_TIMEOUT_SECONDS=0.1
MODEL_PROVIDER_GATEWAY_MAX_TIMEOUT_SECONDS=300

METRICS_ENABLED=true
TRACING_ENABLED=false

WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120

TELEGRAM_WEBHOOK_SECRET=local-dev-secret
TELEGRAM_PROVIDER_TOKEN_REF=qa011/channel-placeholder
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_CALLBACK_SIGNING_SECRET_REF=qa011/channel-placeholder
CHANNEL_ARTIFACT_URL_TTL_SECONDS=900
CHANNEL_ARTIFACT_URL_MAX_TTL_SECONDS=3600
CHANNEL_SSE_HEARTBEAT_SECONDS=15
CHANNEL_RATE_LIMIT_PER_MINUTE=120
