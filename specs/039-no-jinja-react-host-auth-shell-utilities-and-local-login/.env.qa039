APP_ENV=test
APP_NAME=multi-agent-platform-qa039
APP_VERSION=qa039
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
AUTH_MODE=local_principal
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","role_codes":["platform_admin"],"permission_codes":["tenant:read","tenant:admin","operations:read","usage:read","usage:export","membership-admin:read","membership-admin:write","skill-registry:publish","skill-execution:read"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Tenant Admin Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","usage:read","membership-admin:read","skill-registry:install","skill-registry:bind","skill-execution:read"]},"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"Tenant User Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read"]}}
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa039
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa039
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa039/openai":"fake-qa039-openai-secret","qa039/auth0":"fake-qa039-auth0-secret","qa039/local-login":"fake-qa039-local-login-secret"}
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa039-artifacts
METRICS_ENABLED=true
TRACING_ENABLED=false
REACT_ADMIN_ENABLED=true
REACT_ADMIN_ASSET_BASE_PATH=/admin/static/react
AUTH0_DOMAIN=qa039.example.test
AUTH0_ISSUER=https://qa039.example.test/
AUTH0_AUDIENCE=multi-agent-platform-qa039
AUTH0_REQUIRED_ORG_CLAIM=true
TELEGRAM_BOT_SECRET_REF=qa039/telegram-disabled
OPENAI_API_KEY_SECRET_REF=qa039/openai
MODEL_GATEWAY_DEFAULT_PROVIDER=local
MODEL_GATEWAY_LOCAL_BASE_URL=http://127.0.0.1:65535/v1
MODEL_GATEWAY_LIVE_PROBES_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_CHECKPOINT_RETENTION_DAYS=7
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=7
RELIABILITY_MAX_SUBMITTED_WORK=100
RELIABILITY_MAX_ACTIVE_WORK=25
RELIABILITY_RETRY_BUDGET_PER_WINDOW=50
RELIABILITY_MAX_RETRY_ATTEMPTS=1
QA_ARTIFACT_ROOT=.data/qa039-artifacts
QA_PLAYWRIGHT_OUTPUT=output/playwright/qa039_ui
