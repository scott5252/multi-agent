DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa042
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa042
ALEMBIC_CONFIG=alembic.ini
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa042/calendar-placeholder":"fake-calendar-value-qa042","qa042/gmail-placeholder":"fake-gmail-value-qa042","qa042/weather-placeholder":"fake-weather-value-qa042","qa042/telegram-placeholder":"fake-telegram-value-qa042"}
PROVIDER_SECRET_REFERENCE_PREFIX=qa042/
ALLOW_LIVE_PROVIDER_PROBES=false
ALLOW_LIVE_TELEGRAM=false
ALLOW_EXTERNAL_CONNECTORS=false
MODEL_GATEWAY_ENABLE_DIRECT_CALL_GUARDRAIL=true
MODEL_PROVIDER_LOCAL_NO_AUTH_ALLOWLIST=127.0.0.1,localhost
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa042-artifacts
EXPORT_STORAGE_PREFIX=qa042/exports
