APP_ENV=local
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Compatibility QA env requested with Spec 004. Prefer .env.qa004 for new runs.
AUTH_MODE=local_principal
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=multi-agent-platform
AUTH0_REQUIRED_ORG_CLAIM=true

LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_CATALOG_JSON={"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"Tenant User","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","runtime:run","runtime:read"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin","runtime_operator","approver"],"permission_codes":["tenant:read","tenant:admin","runtime:run","runtime:read","runtime:approve","runtime:cancel"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin","runtime_operator"],"permission_codes":["tenant:read","tenant:admin","runtime:run","runtime:read"]},"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","role_codes":["platform_admin","runtime_operator","approver"],"permission_codes":["tenant:admin","runtime:run","runtime:read","runtime:approve","runtime:cancel","runtime:worker"]},"runtime-worker":{"catalog_key":"runtime-worker","display_name":"Runtime Worker","role_codes":["runtime_worker"],"permission_codes":["runtime:worker","runtime:read"]}}

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform
DATABASE_ECHO=false

SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"example/api-key":"dev-secret","runtime/demo-token":"runtime-secret"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/artifacts
S3_BUCKET=multi-agent-platform
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

METRICS_ENABLED=true
TRACING_ENABLED=false

WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=120
RUNTIME_WORKER_ID=qa004-worker-1
RUNTIME_WORKER_LEASE_SECONDS=120
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_RETENTION_DAYS=90
RUNTIME_DEFAULT_RETRY_ATTEMPTS=3
RUNTIME_CRASH_INJECTION_ENABLED=true

COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00
