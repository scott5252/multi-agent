        {
          "id": "004-req-inspect-run",
          "name": "09 Inspect durable workflow run",
          "collectionId": "7f8d6d2a-8e5c-4f7c-9e4d-004000000001",
          "method": "GET",
          "description": "Fetches run state and verifies the pinned bundle digest remains stable.",
          "headers": "X-Local-Principal: {{tenant_admin_principal}}",
          "url": "{{base_url}}/runtime/runs/{{workflow_run_id}}",
          "tests": "pm.test('Status code is 200', function () {\n  pm.response.to.have.status(200);\n});\npm.test('Run id matches the saved workflow_run_id', function () {\n  const json = pm.response.json();\n  pm.expect(json.workflow_run_id).to.eql(pm.environment.get('workflow_run_id') || pm.collectionVariables.get('workflow_run_id'));\n});\npm.test('Bundle digest stays pinned when present', function () {\n  const json = pm.response.json();\n  const expected = pm.environment.get('bundle_digest') || pm.collectionVariables.get('bundle_digest');\n  if (expected && json.bundle_digest) {\n    pm.expect(json.bundle_digest).to.eql(expected);\n  }\n});",
