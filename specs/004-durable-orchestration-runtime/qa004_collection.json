          "id": "004-req-start-run",
          "name": "08 Start durable workflow run",
          "collectionId": "7f8d6d2a-8e5c-4f7c-9e4d-004000000001",
          "method": "POST",
          "description": "Starts a published workflow run and stores workflow_run_id, run_bundle_id, and bundle_digest variables.",
          "headers": "X-Local-Principal: {{tenant_admin_principal}}\nContent-Type: application/json",
          "dataMode": "raw",
          "rawModeData": "{\n  \"published_workflow_version_id\": \"{{published_workflow_version_id}}\",\n  \"idempotency_key\": \"qa004-durable-run-001\",\n  \"input\": {\n    \"prompt\": \"Run the durable orchestration QA path\",\n    \"mode\": \"happy_path\"\n  }\n}",
          "url": "{{base_url}}/runtime/runs",
          "tests": "pm.test('Status code is 202', function () {\n  pm.response.to.have.status(202);\n});\npm.test('Response includes workflow_run_id and bundle details', function () {\n  const json = pm.response.json();\n  pm.expect(json.workflow_run_id).to.exist;\n  pm.expect(json.run_bundle_id).to.exist;\n  pm.expect(json.bundle_digest).to.exist;\n});\nfunction saveVariable(key, value) {\n  if (value === undefined || value === null || value === '') { return; }\n  const stringValue = String(value);\n  pm.environment.set(key, stringValue);\n  pm.collectionVariables.set(key, stringValue);\n}\nconst json = pm.response.json();\nsaveVariable('workflow_run_id', json.workflow_run_id);\nsaveVariable('run_bundle_id', json.run_bundle_id);\nsaveVariable('bundle_digest', json.bundle_digest);",
          "preRequestScript": "",
          "responses": [],
          "responses_order": [],
          "pathVariableData": [],
          "queryParams": [],
          "headerData": [
            {
              "key": "X-Local-Principal",
              "value": "{{tenant_admin_principal}}",
              "type": "text"
            },
            {
              "key": "Content-Type",
              "value": "application/json",
              "type": "text"
            }
          ],
          "dataOptions": {
            "raw": {
              "language": "json"
            }
          },
          "version": 2
