  "item": [
    {
      "name": "Published Workflow Prep",
      "description": "Create, validate, publish, and inspect the QA workflow version used by runtime runs.",
      "item": [
        {
          "name": "05.1 Create runtime QA draft",
          "description": "Creates the tenant-scoped workflow draft used for Spec 004 runtime QA.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Local-Principal",
                "value": "{{tenant_admin_principal}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope_type\": \"tenant\",\n  \"workflow_kind\": \"main_workflow\",\n  \"slug\": \"qa004-durable-demo\",\n  \"display_name\": \"QA004 Durable Demo\",\n  \"document\": {\n    \"workflow_key\": \"qa004-durable-demo\",\n    \"display_name\": \"QA004 Durable Demo\",\n    \"description\": \"Runtime QA workflow for durable execution checks.\",\n    \"workflow_kind\": \"main_workflow\",\n    \"entry_node_key\": \"triage-node\",\n    \"roles\": [\n      {\n        \"role_key\": \"triage-role\",\n        \"display_name\": \"Triage Role\",\n        \"purpose\": \"Process the runtime QA input.\",\n        \"input_contract_key\": \"runtime-request\",\n        \"output_contract_key\": \"runtime-result\",\n        \"skill_bindings\": [\n          {\n            \"binding_key\": \"triage-binding\",\n            \"skill_slug\": \"triage-agent\",\n            \"skill_version\": \"2026.04.1\",\n            \"purpose\": \"Handle deterministic QA execution.\"\n          }\n        ]\n      }\n    ],\n    \"contracts\": [\n      {\n        \"contract_key\": \"runtime-request\",\n        \"json_schema\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"prompt\"\n          ],\n          \"properties\": {\n            \"prompt\": {\n              \"type\": \"string\"\n            },\n            \"mode\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      },\n      {\n        \"contract_key\": \"runtime-result\",\n        \"json_schema\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"status\"\n          ],\n          \"properties\": {\n            \"status\": {\n              \"type\": \"string\"\n            },\n            \"summary\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    ],\n    \"nodes\": [\n      {\n        \"node_key\": \"triage-node\",\n        \"node_type\": \"role\",\n        \"display_name\": \"Triage\",\n        \"role_key\": \"triage-role\"\n      }\n    ],\n    \"edges\": [],\n    \"join_policies\": [],\n    \"approval_gates\": [],\n    \"subworkflow_refs\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/workflows",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "workflows"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is one of 201, 409', function () {",
                  "  pm.expect([201,409]).to.include(pm.response.code);",
                  "});",
                  "function saveVariable(key, value) {",
                  "  if (value === undefined || value === null || value === '') { return; }",
                  "  const stringValue = String(value);",
                  "  pm.environment.set(key, stringValue);",
                  "  pm.collectionVariables.set(key, stringValue);",
                  "}",
                  "const json = pm.response.json();",
                  "if (json.workflow_draft_id) { saveVariable('workflow_draft_id', json.workflow_draft_id); }",
                  "pm.test('Draft id is available or slug already exists', function () {",
                  "  pm.expect(Boolean(json.workflow_draft_id || json.detail)).to.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05.2 Validate runtime QA draft",
          "description": "Validates the latest draft revision and stores validation_result_id.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Local-Principal",
                "value": "{{tenant_admin_principal}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/workflows/drafts/{{workflow_draft_id}}/validate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "workflows",
                "drafts",
                "{{workflow_draft_id}}",
                "validate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "function saveVariable(key, value) {",
                  "  if (value === undefined || value === null || value === '') { return; }",
                  "  const stringValue = String(value);",
                  "  pm.environment.set(key, stringValue);",
                  "  pm.collectionVariables.set(key, stringValue);",
                  "}",
                  "const json = pm.response.json();",
                  "saveVariable('validation_result_id', json.validation_result_id);",
                  "pm.test('Validation passed', function () { pm.expect(json.status).to.equal('passed'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05.3 Publish runtime QA draft",
          "description": "Publishes the validated draft and stores published_workflow_version_id.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Local-Principal",
                "value": "{{tenant_admin_principal}}",
                "type": "text"
