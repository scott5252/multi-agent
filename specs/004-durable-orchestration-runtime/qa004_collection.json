          "const defaults = {",
          "  base_url: 'http://127.0.0.1:8000',",
          "  tenant_admin_principal: 'tenant-admin-acme',",
          "  tenant_user_principal: 'tenant-user-acme',",
          "  globex_admin_principal: 'tenant-admin-globex',",
          "  platform_admin_principal: 'platform-admin',",
          "  acme_tenant_id: '11111111-1111-1111-1111-111111111111',",
          "  globex_tenant_id: '22222222-2222-2222-2222-222222222222'",
          "};",
          "Object.entries(defaults).forEach(([key, value]) => {",
          "  if (!pm.environment.get(key) && !pm.collectionVariables.get(key)) {",
          "    pm.collectionVariables.set(key, value);",
          "  }",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function maybeJson() {",
          "  const body = pm.response.text();",
          "  if (!body) { return null; }",
          "  try { return pm.response.json(); } catch (error) { return null; }",
          "}",
          "function saveVariable(key, value) {",
          "  if (value === undefined || value === null || value === '') { return; }",
          "  const stringValue = String(value);",
          "  pm.environment.set(key, stringValue);",
          "  pm.collectionVariables.set(key, stringValue);",
          "}",
          "saveVariable('last_status_code', pm.response.code);",
          "saveVariable('last_response_body', pm.response.text());",
          "const json = maybeJson();",
          "if (json && json.detail) {",
          "  saveVariable('last_response_detail', typeof json.detail === 'string' ? json.detail : JSON.stringify(json.detail));",
          "}"
        ]
      }
    }
  ],
