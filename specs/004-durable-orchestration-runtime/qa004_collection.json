            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"validation_result_id\": \"{{validation_result_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/workflows/drafts/{{workflow_draft_id}}/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "workflows",
                "drafts",
                "{{workflow_draft_id}}",
                "publish"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "function saveVariable(key, value) {",
                  "  if (value === undefined || value === null || value === '') { return; }",
                  "  const stringValue = String(value);",
                  "  pm.environment.set(key, stringValue);",
                  "  pm.collectionVariables.set(key, stringValue);",
                  "}",
                  "const json = pm.response.json();",
                  "saveVariable('published_workflow_version_id', json.workflow_version_bundle_id);",
                  "saveVariable('compiled_bundle_digest', json.compiled_bundle_digest);",
                  "pm.test('Published workflow version id saved', function () { pm.expect(json.workflow_version_bundle_id).to.be.a('string'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05.4 Inspect published workflow version",
          "description": "Confirms the published workflow version is visible to the Acme tenant admin.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Local-Principal",
                "value": "{{tenant_admin_principal}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/workflows/versions/{{published_workflow_version_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "workflows",
                "versions",
                "{{published_workflow_version_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Version detail returned', function () { pm.expect(pm.response.json().workflow_version_bundle_id).to.equal(pm.collectionVariables.get('published_workflow_version_id') || pm.environment.get('published_workflow_version_id')); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
