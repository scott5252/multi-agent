                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "function saveVariable(key, value) {",
                  "  if (value === undefined || value === null || value === '') { return; }",
                  "  const stringValue = String(value);",
                  "  pm.environment.set(key, stringValue);",
                  "  pm.collectionVariables.set(key, stringValue);",
                  "}",
                  "const json = pm.response.json();",
                  "saveVariable('workflow_run_id', json.workflow_run_id);",
                  "saveVariable('run_bundle_id', json.run_bundle_id);",
                  "saveVariable('bundle_digest', json.bundle_digest);",
                  "pm.test('Run is accepted', function () { pm.expect(['pending', 'runnable']).to.include(json.status); });"
                ]
              }
            }
