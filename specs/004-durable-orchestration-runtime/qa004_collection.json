            "body": {
              "mode": "raw",
              "raw": "{\n  \"published_workflow_version_id\": \"{{published_workflow_version_id}}\",\n  \"idempotency_key\": \"qa004-durable-run-001\",\n  \"input\": {\n    \"prompt\": \"Run the durable orchestration QA path\",\n    \"mode\": \"happy_path\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
