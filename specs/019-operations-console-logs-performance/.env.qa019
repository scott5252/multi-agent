# QA019 self-contained local environment.
# Copy this file to repo-root .env before running the QA019 checklist.

APP_ENV=test
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00

AUTH_MODE=local_principal
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","tenant_id":null,"org_id":"platform","role_codes":["platform_admin"],"permission_codes":["platform:admin","operations:read","operations:logs","operations:export","usage:read","telegram-config:read","agent-tests:read"]},"auditor":{"catalog_key":"auditor","display_name":"Platform Auditor","tenant_id":null,"org_id":"platform","role_codes":["auditor"],"permission_codes":["operations:read","operations:logs","operations:export"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Acme Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","operations:read","operations:logs","operations:export"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]}}

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa019
DATABASE_ECHO=false
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa019
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=90

SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa019/telegram-provider-token":"qa019-fake-token","qa019/channel-callback":"qa019-fake-callback-secret"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa019-artifacts
S3_BUCKET=multi-agent-platform-qa019
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

METRICS_ENABLED=true
TRACING_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120

TELEGRAM_WEBHOOK_SECRET=static:qa019/webhook
TELEGRAM_PROVIDER_TOKEN_REF=static:qa019/telegram-provider-token
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_CALLBACK_SIGNING_SECRET_REF=static:qa019/channel-callback
CHANNEL_ARTIFACT_URL_TTL_SECONDS=900
CHANNEL_ARTIFACT_URL_MAX_TTL_SECONDS=3600
CHANNEL_SSE_HEARTBEAT_SECONDS=15
CHANNEL_RATE_LIMIT_PER_MINUTE=120
