","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit","telegram-config:read","telegram-config:write","telegram-config:tokens","telegram-config:diagnostics","briefing-preferences:read","briefing-preferences:write","briefing-preferences:export","briefing-preferences:resolve","channel:runs:read"]}}
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa045
