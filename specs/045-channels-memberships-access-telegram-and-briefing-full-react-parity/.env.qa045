ALEMBIC_CONFIG=alembic.ini
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa045/telegram-placeholder":"fake-telegram-value-qa045","qa045/briefing-calendar-placeholder":"fake-calendar-value-qa045","qa045/briefing-email-placeholder":"fake-email-value-qa045","qa045/membership-placeholder":"fake-membership-value-qa045"}
PROVIDER_SECRET_REFERENCE_PREFIX=qa045/
ALLOW_LIVE_PROVIDER_PROBES=false
ALLOW_LIVE_TELEGRAM=false
