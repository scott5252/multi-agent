    "commands": [
      {
        "id": "queue-complete",
        "command": "jq -e '.next_spec == null and all(.specs[]; .status == \"completed\" and .validation == \"completed\")' specs/_autopilot/wizard-ui-roadmap/queue.json"
      },
      {
        "id": "qa-docs-all",
        "command": "set -e; for d in specs/074-console-home-onboarding-wizard-entry-and-fixed-frame-shell specs/075-generic-scenario-intake-and-durable-draft-blueprint specs/076-stepwise-agents-contracts-and-graph-configuration specs/077-resource-readiness-bindings-and-evidence-configuration specs/078-publish-launch-and-operational-verification-finish specs/079-non-scrolling-wizard-qa-docs-and-guardrails; do bash .specify/extensions/qa-docs/scripts/bash/validate-qa-documents.sh \"$d\"; done"
      },
      {
        "id": "spec-qa-all",
        "command": "set -e; for f in specs/_autopilot/wizard-ui-roadmap/*/validation.yml; do uv run python scripts/qa/run_spec_qa.py \"$f\"; done"
      },
      {
        "id": "playwright-all",
        "command": "set -e; for f in specs/_autopilot/wizard-ui-roadmap/*/validation.yml; do uv run python scripts/qa/run_playwright_ui.py \"$f\" --start-processes; done"
      },
      {
        "id": "ruff-check",
        "command": "uv run ruff check ."
      },
      {
        "id": "ruff-format-check",
        "command": "uv run ruff format --check ."
      },
      {
        "id": "mypy",
        "command": "uv run mypy src"
      },
      {
        "id": "pytest-coverage",
        "command": "uv run pytest --cov=src/multi_agent_platform --cov-report=term-missing --cov-fail-under=90"
      },
      {
        "id": "generated-react-types-fresh",
        "command": "uv run python scripts/frontend/generate_admin_react_types.py --check"
      },
      {
        "id": "frontend-install-deps",
        "command": "cd frontend/admin && npm ci"
      },
      {
        "id": "frontend-typecheck",
        "command": "cd frontend/admin && npm run typecheck"
      },
      {
        "id": "frontend-vitest",
        "command": "cd frontend/admin && npm test"
      },
      {
        "id": "frontend-build",
        "command": "cd frontend/admin && npm run build"
      },
      {
        "id": "multi-agent-curl-test-final",
        "command": "if ! docker info >/dev/null 2>&1; then command -v open >/dev/null 2>&1 && open -a Docker || true; for i in $(seq 1 60); do docker info >/dev/null 2>&1 && break; sleep 5; done; fi; docker info >/dev/null && docker compose up -d postgres && uv run python .agents/skills/multi-agent-curl-test/scripts/run_curl_test.py --output-dir .data/curl_test_runs/wizard-ui-roadmap-final"
      }
    ]
