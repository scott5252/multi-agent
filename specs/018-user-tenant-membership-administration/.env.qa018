# QA018 local environment for User And Tenant Membership Administration
APP_ENV=local
APP_NAME=multi-agent-platform-qa018
APP_VERSION=0.1.0-qa018
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Local reviewer authentication
AUTH_MODE=local_principal
AUTH0_DOMAIN=qa018.local.auth0.example
AUTH0_ISSUER=https://qa018.local.auth0.example/
AUTH0_AUDIENCE=multi-agent-platform-qa018
AUTH0_REQUIRED_ORG_CLAIM=true
AUTH0_JWKS_PATH=/.well-known/jwks.json
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"platform-admin":{"catalog_key":"platform-admin","display_name":"QA018 Platform Admin","tenant_id":null,"org_id":"org-platform","role_codes":["platform_admin"],"permission_codes":["platform:admin","tenant:admin","tenant:read","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit"]},"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"QA018 Acme Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_admin","tenant_user"],"permission_codes":["tenant:read","tenant:admin","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit"]},"tenant-user-acme":{"catalog_key":"tenant-user-acme","display_name":"QA018 Acme Tenant User","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read"]},"auditor-acme":{"catalog_key":"auditor-acme","display_name":"QA018 Acme Auditor","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","membership-admin:read","membership-admin:audit"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"QA018 Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_admin","tenant_user"],"permission_codes":["tenant:read","tenant:admin","membership-admin:read","membership-admin:invite","membership-admin:write","membership-admin:grants","membership-admin:audit"]}}

# Dedicated QA018 database
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa018
RUNTIME_CHECKPOINTER_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform_qa018
DATABASE_ECHO=false

# Safe static secret references used by local QA only
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa018/auth0-placeholder":"qa018-fake-auth0-value","qa018/email-placeholder":"qa018-fake-email-value","qa018/local-cookie-signing":"qa018-fake-cookie-value"}
ENV_SECRET_PREFIX=QA018_SECRET_
SECRET_MANAGER_PREFIX=qa018/

# Local artifact storage
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa018-artifacts
S3_BUCKET=qa018-unused-bucket
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

# Observability and worker settings
METRICS_ENABLED=true
TRACING_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120
RUNTIME_CHECKPOINT_RETENTION_DAYS=7
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=7

# Reliability defaults kept small for a single reviewer machine
RELIABILITY_MAX_SUBMITTED_WORK=100
RELIABILITY_MAX_ACTIVE_WORK=25
RELIABILITY_RETRY_BUDGET_PER_WINDOW=50
RELIABILITY_MAX_RETRY_ATTEMPTS=2
RELIABILITY_ARTIFACT_TENANT_CONCURRENCY=2
RELIABILITY_ARTIFACT_GLOBAL_CONCURRENCY=8
