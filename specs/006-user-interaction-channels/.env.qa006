# QA006 self-contained local environment.
# Copy this file to repo-root .env before running the QA006 checklist.

# Application
APP_ENV=test
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00

# Authentication
AUTH_MODE=local_principal
AUTH0_DOMAIN=qa006.local.auth0.example
AUTH0_ISSUER=https://qa006.local.auth0.example/
AUTH0_AUDIENCE=multi-agent-platform-qa006
AUTH0_ALGORITHMS=["RS256"]
AUTH0_REQUIRED_ORG_CLAIM=true
AUTH0_JWKS_PATH=/.well-known/jwks.json
LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_COOKIE_NAME=map_local_principal
LOCAL_PRINCIPAL_CATALOG_JSON={"tenant-admin-acme":{"catalog_key":"tenant-admin-acme","display_name":"Tenant Admin","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]},"tenant-admin-globex":{"catalog_key":"tenant-admin-globex","display_name":"Globex Tenant Admin","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","tenant_admin"],"permission_codes":["tenant:read","tenant:admin"]}}

# Database
DATABASE_URL=sqlite+aiosqlite:///./.data/qa006.db
DATABASE_ECHO=false
RUNTIME_CHECKPOINTER_DATABASE_URL=sqlite+aiosqlite:///./.data/qa006.db
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_REF_RETENTION_DAYS=90

# Secrets
SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"qa006/callback-signing-secret":"qa006-callback-signing-secret","qa006/telegram-provider-token":"qa006-telegram-provider-token"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

# Storage
STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/qa006-artifacts
S3_BUCKET=multi-agent-platform-qa006
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=false

# Workers
WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=60
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.1
RUNTIME_WORKER_LEASE_SECONDS=120

# User interaction channels
TELEGRAM_WEBHOOK_SECRET=local-dev-secret
TELEGRAM_PROVIDER_TOKEN_REF=qa006/telegram-provider-token
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_CALLBACK_SIGNING_SECRET_REF=qa006/callback-signing-secret
CHANNEL_ARTIFACT_URL_TTL_SECONDS=900
CHANNEL_ARTIFACT_URL_MAX_TTL_SECONDS=3600
CHANNEL_SSE_HEARTBEAT_SECONDS=15
CHANNEL_RATE_LIMIT_PER_MINUTE=120
