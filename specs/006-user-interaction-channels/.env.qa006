APP_ENV=local
APP_NAME=multi-agent-platform
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# qa006 focuses on user interaction channels: Web UI, Web API, Telegram,
# status/timeline/result retrieval, approvals/resumes, notifications,
# callbacks, and artifact URL grants.
AUTH_MODE=local_principal
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=multi-agent-platform
AUTH0_REQUIRED_ORG_CLAIM=true

LOCAL_PRINCIPAL_HEADER=X-Local-Principal
LOCAL_PRINCIPAL_CATALOG_JSON={"channel-user-acme":{"catalog_key":"channel-user-acme","display_name":"Channel User Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","workflow_runner"],"permission_codes":["tenant:read","runtime:run","runtime:read","channels:run","channels:read","channels:result","channels:artifact","channels:subscribe"]},"channel-reviewer-acme":{"catalog_key":"channel-reviewer-acme","display_name":"Channel Reviewer Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","workflow_runner","approver"],"permission_codes":["tenant:read","runtime:run","runtime:read","runtime:approve","runtime:cancel","channels:run","channels:read","channels:result","channels:artifact","channels:subscribe","channels:approve","channels:resume","channels:cancel"]},"channel-api-client-acme":{"catalog_key":"channel-api-client-acme","display_name":"Channel API Client Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user","api_client","workflow_runner"],"permission_codes":["tenant:read","runtime:run","runtime:read","runtime:cancel","channels:run","channels:read","channels:result","channels:artifact","channels:subscribe","channels:callback","channels:cancel"]},"channel-user-globex":{"catalog_key":"channel-user-globex","display_name":"Channel User Globex","tenant_id":"22222222-2222-2222-2222-222222222222","org_id":"org-globex","role_codes":["tenant_user","workflow_runner"],"permission_codes":["tenant:read","runtime:run","runtime:read","channels:run","channels:read","channels:result","channels:artifact","channels:subscribe"]},"channel-observer-acme":{"catalog_key":"channel-observer-acme","display_name":"Channel Observer Acme","tenant_id":"11111111-1111-1111-1111-111111111111","org_id":"org-acme","role_codes":["tenant_user"],"permission_codes":["tenant:read","runtime:read","channels:read","channels:subscribe"]},"platform-admin":{"catalog_key":"platform-admin","display_name":"Platform Admin","role_codes":["platform_admin","runtime_operator","approver","channel_operator"],"permission_codes":["tenant:admin","runtime:run","runtime:read","runtime:approve","runtime:cancel","runtime:worker","channels:run","channels:read","channels:approve","channels:resume","channels:cancel","channels:result","channels:artifact","channels:subscribe","channels:callback","channels:admin"]},"runtime-worker":{"catalog_key":"runtime-worker","display_name":"Runtime Worker","role_codes":["runtime_worker"],"permission_codes":["runtime:worker","runtime:read"]},"channel-delivery-worker":{"catalog_key":"channel-delivery-worker","display_name":"Channel Delivery Worker","role_codes":["runtime_worker","channel_delivery_worker"],"permission_codes":["runtime:read","channels:read","channels:deliver","channels:callback"]}}

DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/multi_agent_platform
DATABASE_ECHO=false

SECRET_PROVIDER=static
STATIC_SECRETS_JSON={"example/api-key":"dev-secret","runtime/demo-token":"runtime-secret","channels/callback-signing":"qa006-callback-secret","channels/telegram-bot-token":"qa006-telegram-token"}
ENV_SECRET_PREFIX=MAP_SECRET_
SECRET_MANAGER_PREFIX=secret-manager/

STORAGE_PROVIDER=filesystem
FILESYSTEM_STORAGE_ROOT=.data/artifacts
S3_BUCKET=multi-agent-platform
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1

METRICS_ENABLED=true
TRACING_ENABLED=false

WORKER_POLL_INTERVAL_SECONDS=0.1
WORKER_LEASE_SECONDS=120
RUNTIME_WORKER_ID=qa006-runtime-worker-1
RUNTIME_WORKER_LEASE_SECONDS=120
RUNTIME_CHECKPOINT_RETENTION_DAYS=90
RUNTIME_PAYLOAD_RETENTION_DAYS=90
RUNTIME_DEFAULT_RETRY_ATTEMPTS=3
RUNTIME_CRASH_INJECTION_ENABLED=false

# Channel layer local QA settings.
CHANNEL_RUNTIME_WORKFLOW_ID=qa006-channel-demo
CHANNEL_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
CHANNEL_IDEMPOTENCY_TTL_SECONDS=86400
CHANNEL_ARTIFACT_URL_TTL_SECONDS=300
CHANNEL_TIMELINE_DEFAULT_LIMIT=100
CHANNEL_SSE_HEARTBEAT_SECONDS=10
CHANNEL_POLL_MIN_SECONDS=2
CHANNEL_POLL_MAX_SECONDS=10
CHANNEL_RATE_LIMIT_PER_MINUTE=120
CHANNEL_RATE_LIMIT_BURST=30
CHANNEL_NOTIFICATION_RETRY_MAX_ATTEMPTS=3
CHANNEL_NOTIFICATION_RETRY_BASE_SECONDS=5
CHANNEL_CALLBACK_RETRY_MAX_ATTEMPTS=3
CHANNEL_CALLBACK_RETRY_BASE_SECONDS=5
CHANNEL_CALLBACK_SIGNING_SECRET_REF=channels/callback-signing
CHANNEL_ALLOW_LOCAL_CALLBACK_URLS=true

# Telegram webhook simulation settings for qa006.md.
TELEGRAM_BOT_TOKEN_SECRET_REF=channels/telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=qa006-local-telegram-secret
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
TELEGRAM_ALLOWED_TEST_CHAT_ID=12345
TELEGRAM_ALLOWED_TEST_USER_ID=67890
TELEGRAM_SEND_ENABLED=false
TELEGRAM_PROVIDER_RATE_LIMIT_PER_SECOND=1

COMMIT_SHA=dev
BUILD_TIME=1970-01-01T00:00:00+00:00
